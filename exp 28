import numpy as np

maze = np.zeros((4, 4))
start = (0, 0)
goal = (3, 3)

# Actions: Up, Down, Left, Right
actions = [(-1,0), (1,0), (0,-1), (0,1)]

policy = np.ones((4, 4, 4)) / 4

for episode in range(1000):

    state = start
    states, acts, rewards = [], [], []

    for step in range(30):

        a = np.random.choice(4, p=policy[state])
        ns = (state[0] + actions[a][0],
              state[1] + actions[a][1])

        reward = -1

        if not (0 <= ns[0] < 4 and 0 <= ns[1] < 4):
            ns = state
            reward = -5

        if ns == goal:
            reward = 10

        states.append(state)
        acts.append(a)
        rewards.append(reward)

        state = ns

        if state == goal:
            break

    # REINFORCE update
    G = 0
    for s, a, r in reversed(list(zip(states, acts, rewards))):
        G = r + 0.9 * G
        policy[s][a] += 0.01 * G

        policy[s] = np.maximum(policy[s], 0.01)
        policy[s] /= policy[s].sum()

print("Learned Navigation Policy:")

symbols = ["↑", "↓", "←", "→"]

for i in range(4):
    print([symbols[np.argmax(policy[i, j])] for j in range(4)])
