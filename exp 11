#11) Implement Double DQN to optimize a stock trading strategy. The agent should learn to buy,
#sell, or hold stocks to maximize profits. Write a Python script to simulate the trading
#environment and train the agent.
import numpy as np
import random
from collections import deque

# Try: pip install tensorflow
import tensorflow as tf
from tensorflow.keras import Sequential
from tensorflow.keras.layers import Dense

np.random.seed(42)
random.seed(42)

# -----------------------------------
# Simulated Stock Trading Environment
# -----------------------------------
class TradingEnvironment:

    def __init__(self, prices):
        self.prices = prices
        self.reset()

    def reset(self):
        self.day = 0
        self.cash = 1000
        self.shares = 0
        return self.state()

    def state(self):
        price = self.prices[self.day]
        return np.array([
            price / 100,
            self.cash / 1000,
            self.shares
        ], dtype=np.float32)

    def step(self, action):
        price = self.prices[self.day]
        old_value = self.cash + self.shares * price

        # 0 = Hold, 1 = Buy, 2 = Sell
        if action == 1 and self.cash >= price:
            self.cash -= price
            self.shares += 1

        elif action == 2 and self.shares > 0:
            self.cash += price
            self.shares -= 1

        self.day += 1

        done = self.day >= len(self.prices) - 1

        new_price = self.prices[self.day]
        new_value = self.cash + self.shares * new_price

        reward = new_value - old_value

        return self.state(), reward, done


# -----------------------------------
# Create Simulated Stock Prices
# -----------------------------------
prices = [100]

for _ in range(250):
    change = np.random.normal(0.2, 2)
    prices.append(max(1, prices[-1] + change))


# -----------------------------------
# Double DQN Agent
# -----------------------------------
class DoubleDQN:

    def __init__(self):
        self.state_size = 3
        self.action_size = 3

        self.gamma = 0.95
        self.epsilon = 1.0
        self.epsilon_min = 0.05
        self.epsilon_decay = 0.995
        self.learning_rate = 0.001

        self.memory = deque(maxlen=5000)

        self.model = self.build_model()
        self.target_model = self.build_model()

        self.update_target()

    def build_model(self):
        model = Sequential([
            Dense(32, activation="relu",
                  input_shape=(self.state_size,)),
            Dense(32, activation="relu"),
            Dense(self.action_size, activation="linear")
        ])

        model.compile(
            optimizer=tf.keras.optimizers.Adam(
                learning_rate=self.learning_rate
            ),
            loss="mse"
        )

        return model

    def update_target(self):
        self.target_model.set_weights(
            self.model.get_weights()
        )

    def remember(self, state, action, reward,
                 next_state, done):
        self.memory.append(
            (state, action, reward, next_state, done)
        )

    def act(self, state):

        if np.random.random() < self.epsilon:
            return random.randrange(self.action_size)

        q_values = self.model.predict(
            state.reshape(1, -1), verbose=0
        )

        return np.argmax(q_values[0])

    # --------------------------------
    # Double DQN Training
    # --------------------------------
    def train(self, batch_size=32):

        if len(self.memory) < batch_size:
            return

        batch = random.sample(
            self.memory, batch_size
        )

        states = np.array([x[0] for x in batch])
        actions = np.array([x[1] for x in batch])
        rewards = np.array([x[2] for x in batch])
        next_states = np.array([x[3] for x in batch])
        dones = np.array([x[4] for x in batch])

        # Online network selects best next action
        next_actions = np.argmax(
            self.model.predict(
                next_states, verbose=0
            ),
            axis=1
        )

        # Target network evaluates selected action
        next_q = self.target_model.predict(
            next_states, verbose=0
        )

        targets = rewards.copy()

        for i in range(batch_size):

            if not dones[i]:
                targets[i] += (
                    self.gamma *
                    next_q[i, next_actions[i]]
                )

        q_values = self.model.predict(
            states, verbose=0
        )

        for i in range(batch_size):
            q_values[i, actions[i]] = targets[i]

        self.model.fit(
            states,
            q_values,
            epochs=1,
            verbose=0
        )

        if self.epsilon > self.epsilon_min:
            self.epsilon *= self.epsilon_decay


# -----------------------------------
# Training
# -----------------------------------
agent = DoubleDQN()

episodes = 50
batch_size = 32

for episode in range(episodes):

    env = TradingEnvironment(prices)
    state = env.reset()
    total_reward = 0

    done = False

    while not done:

        action = agent.act(state)

        next_state, reward, done = env.step(action)

        agent.remember(
            state,
            action,
            reward,
            next_state,
            done
        )

        state = next_state
        total_reward += reward

        agent.train(batch_size)

    # Update target network periodically
    if episode % 5 == 0:
        agent.update_target()

    print(
        f"Episode {episode + 1}: "
        f"Reward = {total_reward:.2f}, "
        f"Epsilon = {agent.epsilon:.3f}"
    )


# -----------------------------------
# Test the Trained Agent
# -----------------------------------
env = TradingEnvironment(prices)
state = env.reset()

done = False
actions_taken = []

while not done:

    q_values = agent.model.predict(
        state.reshape(1, -1),
        verbose=0
    )

    action = np.argmax(q_values[0])

    actions_taken.append(action)

    state, reward, done = env.step(action)


print("\nFinal Trading Results")
print("---------------------")
print("Final Cash   :", round(env.cash, 2))
print("Shares Held  :", env.shares)
print("Final Price  :", round(prices[-1], 2))
print(
    "Portfolio Value:",
    round(env.cash + env.shares * prices[-1], 2)
)

print("\nActions:")
print("0 = Hold, 1 = Buy, 2 = Sell")
print(actions_taken)
